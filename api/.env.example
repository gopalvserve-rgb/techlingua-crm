# Tech Lingua CRM API — copy to .env and fill in. Never commit real secrets.
PORT=3001

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/techlingua_crm

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Seed (used once by npm run db:seed)
SEED_ADMIN_EMAIL=admin@techlingua.in
SEED_ADMIN_PASSWORD=ChangeMe@123

# CORS origin of the web app
WEB_ORIGIN=http://localhost:5173
